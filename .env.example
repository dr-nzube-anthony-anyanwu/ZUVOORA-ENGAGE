# ZUVOORA Engage — API / Docker Compose environment template. Copy to `.env` (gitignored).
# Placeholders only. Never commit real values; never paste them into chat, tickets or screenshots.
# For local development run `npm run env:local` instead (writes apps/api/.env from local Supabase).

APP_ENV=development
APP_NAME=ZUVOORA Engage
API_PORT=8073
WEB_PORT=3073
API_CORS_ORIGINS=http://localhost:3073
DASHBOARD_URL=http://localhost:3073
LOG_LEVEL=INFO

# --- Supabase (dedicated Engage project; NOT the ZUVOORA Core project) ---
# Public, browser-safe values (also used by apps/web as NEXT_PUBLIC_*):
SUPABASE_URL=https://YOUR_ENGAGE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SERVER-ONLY secrets (API container only; never in apps/web):
SUPABASE_SECRET_KEY=replace_me_server_only_never_browser
# Postgres as the least-privileged engage_api role (password set by you in the Supabase SQL editor):
DATABASE_URL=postgresql://engage_api.YOUR_ENGAGE_PROJECT_REF:replace_me@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Later phases (leave as placeholders until the phase begins) ---
RESEND_API_KEY=replace_me
EMAIL_FROM=ZUVOORA Engage <no-reply@example.com>
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
REDIS_URL=redis://redis:6379/0

# Website domain verification (DNS TXT). Empty = the server's own resolvers.
DNS_RESOLVERS=
DNS_TIMEOUT_SECONDS=4
DOMAIN_VERIFY_COOLDOWN_SECONDS=15
# Public chat widget (Phase 3b). Required outside development: 32+ random characters.
WIDGET_TOKEN_SECRET=replace_with_long_random_secret
# Development/test only: allow http:// websites to embed the widget. Never in production.
WIDGET_ALLOW_HTTP_FRAMES=false

# --- AI answers (Phase 3d, ADR-026/029). Off unless AI_ENABLED=true. ---
# Use a DEDICATED OpenRouter key with its own credit limit (e.g. $1) as the hard spending stop.
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ENABLED=false
# "primary,backup" pinned OpenRouter model ids (no ~...-latest aliases).
AI_STANDARD_MODELS=deepseek/deepseek-v4-flash,openai/gpt-6-luna
AI_COMPLEX_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-6-luna
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=300
# Budgets in USD, checked before every model call (tenant daily <= global daily <= monthly).
AI_BUDGET_TENANT_DAILY_USD=0.20
AI_BUDGET_GLOBAL_DAILY_USD=0.50
AI_BUDGET_GLOBAL_MONTHLY_USD=2.00
# Worst-case provider price per million tokens; also sent to OpenRouter as max_price.
AI_MAX_PROMPT_USD_PER_MTOK=0.50
AI_MAX_COMPLETION_USD_PER_MTOK=1.00
