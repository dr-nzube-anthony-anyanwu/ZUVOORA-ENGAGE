{
  "name": "zuvoora-engage",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-level tooling for ZUVOORA Engage (Supabase CLI). App code lives in apps/*.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "env:local": "node scripts/write-local-env.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.1"
  }
}
