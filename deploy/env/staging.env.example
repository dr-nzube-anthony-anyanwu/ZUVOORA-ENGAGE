# ZUVOORA Engage — STAGING settings template (Phase 6). PLACEHOLDERS ONLY.
#
# On the server this becomes /opt/zuvoora-engage/staging/.env  (owner root, mode 600).
# Staging uses SYNTHETIC data only and its OWN secrets: never copy a production value here
# (preflight.sh refuses identical secrets). The staging dashboard is behind Cloudflare Access.

# ----- Deployment (read by deploy/compose.yml) -----------------------------------------------
ENGAGE_ENV=staging
ENGAGE_ENV_FILE=/opt/zuvoora-engage/staging/.env
# The release (image digests) is NOT set here: deploy.sh writes it to release.env.
ENGAGE_EDGE_NETWORK=engage-edge-staging
ENGAGE_EDGE_SUBNET=10.73.10.0/24
ENGAGE_INTERNAL_SUBNET=10.73.11.0/24
FORWARDED_ALLOW_IPS=10.73.10.0/24,10.73.11.0/24

# ----- Application --------------------------------------------------------------------------------
APP_ENV=staging
LOG_LEVEL=INFO
DASHBOARD_URL=https://staging-engage.zuvoora.com
API_CORS_ORIGINS=https://staging-engage.zuvoora.com
PUBLIC_API_URL=https://staging-api-engage.zuvoora.com

# Supabase STAGING project (the existing cloud project)
SUPABASE_URL=https://fjgthmmntjqdcrkajfaf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_SECRET_KEY=REPLACE
# Only the engage_api PASSWORD is secret: replace REPLACE_ENGAGE_API_PASSWORD (letters and digits).
DATABASE_URL=postgresql://engage_api.fjgthmmntjqdcrkajfaf:REPLACE_ENGAGE_API_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

WIDGET_TOKEN_SECRET=REPLACE
INTEGRATIONS_ENCRYPTION_KEY=REPLACE
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=
CALCOM_API_URL=https://api.cal.com

# Email: real sending, but ONLY to these test addresses/@domains (comma-separated).
EMAIL_DELIVERY=resend
RESEND_API_KEY=REPLACE
EMAIL_FROM=ZUVOORA Engage (staging) <no-reply@engage.zuvoora.com>
EMAIL_ALLOWED_RECIPIENTS=REPLACE_TEST_INBOX
DEMO_REQUEST_NOTIFY_EMAIL=

# AI with the STAGING OpenRouter key (credit limit $1).
OPENROUTER_API_KEY=REPLACE
AI_ENABLED=true
AI_VISION_ENABLED=true
AI_BUDGET_TENANT_DAILY_USD=0.10
AI_BUDGET_GLOBAL_DAILY_USD=0.20
AI_BUDGET_GLOBAL_MONTHLY_USD=1.00
