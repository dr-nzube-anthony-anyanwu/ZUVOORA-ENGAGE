# ZUVOORA Engage — PRODUCTION settings template (Phase 6). PLACEHOLDERS ONLY.
#
# On the server this becomes /opt/zuvoora-engage/production/.env  (owner root, mode 600):
#   sudo cp deploy/env/production.env.example /opt/zuvoora-engage/production/.env
#   sudo chmod 600 /opt/zuvoora-engage/production/.env
#   sudo nano /opt/zuvoora-engage/production/.env      # paste values from the password manager
# Never commit the real file, paste it into chat, or reuse a staging value here.
# Use letters, digits, - and _ in values you choose yourself ($ and quotes need escaping).
# `sudo deploy/scripts/preflight.sh production` checks this file without printing any value.

# ----- Deployment (read by deploy/compose.yml) -----------------------------------------------
ENGAGE_ENV=prod
ENGAGE_ENV_FILE=/opt/zuvoora-engage/production/.env
# The release (image digests) is NOT set here: deploy.sh writes it to release.env.
# Private networks (fixed so the API can trust exactly the proxy and the dashboard).
ENGAGE_EDGE_NETWORK=engage-edge-prod
ENGAGE_EDGE_SUBNET=10.73.0.0/24
ENGAGE_INTERNAL_SUBNET=10.73.1.0/24
FORWARDED_ALLOW_IPS=10.73.0.0/24,10.73.1.0/24

# ----- Application --------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
DASHBOARD_URL=https://engage.zuvoora.com
API_CORS_ORIGINS=https://engage.zuvoora.com
PUBLIC_API_URL=https://api-engage.zuvoora.com

# Supabase PRODUCTION project (public values; also used by the dashboard)
SUPABASE_URL=https://REPLACE_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# SERVER-ONLY secrets
SUPABASE_SECRET_KEY=REPLACE
DATABASE_URL=postgresql://engage_api.REPLACE_PRODUCTION_PROJECT_REF:REPLACE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Generated ON THE SERVER (commands in docs/operations/PRODUCTION_DEPLOYMENT.md §2); also kept in
# the password manager. Losing INTEGRATIONS_ENCRYPTION_KEY disconnects every clinic's calendar.
WIDGET_TOKEN_SECRET=REPLACE
INTEGRATIONS_ENCRYPTION_KEY=REPLACE
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=
CALCOM_API_URL=https://api.cal.com

# Email (Resend, production sending-only key; domain engage.zuvoora.com)
EMAIL_DELIVERY=resend
RESEND_API_KEY=REPLACE
EMAIL_FROM=ZUVOORA Engage <no-reply@engage.zuvoora.com>
EMAIL_ALLOWED_RECIPIENTS=
# The founder's mailbox for demo-request alerts (typed here on the server, never in Git).
DEMO_REQUEST_NOTIFY_EMAIL=

# AI (founder decision D4: on at launch). Production OpenRouter key with its own credit limit.
OPENROUTER_API_KEY=REPLACE
AI_ENABLED=true
AI_VISION_ENABLED=true
AI_BUDGET_TENANT_DAILY_USD=0.20
AI_BUDGET_GLOBAL_DAILY_USD=0.50
AI_BUDGET_GLOBAL_MONTHLY_USD=2.00

# Virus scanning (D5) and worker — set by deploy/compose.yml; listed for completeness.
# MALWARE_SCAN_REQUIRED=true  CLAMAV_HOST=clamav  WORKER_RUN_SCHEDULES=true
