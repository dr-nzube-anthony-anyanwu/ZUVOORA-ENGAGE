# ZUVOORA Engage dashboard — copy to `.env.local` (gitignored), or run `npm run env:local` at the
# repository root for local development.
#
# NEXT_PUBLIC_* values are inlined into browser JavaScript at build time. Only put values here
# that are SAFE TO PUBLISH: the Supabase project URL and the publishable key.
# NEVER add the Supabase secret / service-role key, DATABASE_URL or any provider API key.
# `npm run check:bundle` fails the build if a server secret reaches browser files.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ENGAGE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side only (not NEXT_PUBLIC): where the dashboard's server calls the Engage API.
ENGAGE_API_URL=http://127.0.0.1:8000
