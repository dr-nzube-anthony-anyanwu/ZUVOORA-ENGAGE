# Normalise line endings: store and check out text as LF on every OS.
# Prevents CRLF breaking shell scripts, Dockerfiles and YAML in Linux containers/CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never modify
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
